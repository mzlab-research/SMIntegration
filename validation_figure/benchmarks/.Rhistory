metabdatabse<-annotationdatabase(omics="metab",species=species)
transdatabse<-annotationdatabase(omics="trans",species=species)
annotation_database<-list(metabdatabse,transdatabse)
#' @title Perform Functional Enrichment Analysis
#' @description Wrapper function to identify differential features, map them to KEGG pathways,
#' and calculate enrichment statistics for dot plots and Venn diagrams.
#' @param diff_omics List containing differential analysis results for metabolomics and transcriptomics.
#' @param metabidenti Metabolite identification table.
#' @param transidenti Gene identification table.
#' @param annotation_database List of KEGG databases for the species.
#' @param functional_diffdata Selection filter ("Up", "Down", "all").
#' @return A list containing Venn diagram data and Dot plot data.
bub=function(diff_omics,metabidenti,transidenti,annotation_database,
functional_diffdata="all"){
# Process Metabolomics Data
diff_m<-diff_omics[[1]] %>%
dplyr::filter(State!="Non-significant") %>%
dplyr::select(metabolite,p_val_adj,`log2(Fold Change)`,State)
if(functional_diffdata=="Up"){
diff_m<-diff_m %>% dplyr::filter(State=="Up")
}else if(functional_diffdata=="Down"){
diff_m<-diff_m %>% dplyr::filter(State=="Down")
}
if(nrow(diff_m) > 300){
diff_m %<>% arrange(p_val_adj)
diff_m <- diff_m[1:300,]
}
diff_m$metabolite<-as.character(diff_m$metabolite)
mzid <-unique(diff_m$metabolite)
data<-data.frame(metabolite=mzid) %>%
left_join(metabidenti,by=c("metabolite"="metabolite"))
data$metabolite<-as.character(data$metabolite)
data <-data[!is.na(data$KEGG.ID), ]
metabannotationdata<-data %>%
left_join(diff_m,by=c("metabolite"="metabolite"))
# Process Transcriptomics Data
diff_t<-diff_omics[[2]] %>%
dplyr::filter(State!="Non-significant") %>%
dplyr::select(gene,p_val_adj,`log2(Fold Change)`,State)
if(functional_diffdata=="Up"){
diff_t<-diff_t %>% dplyr::filter(State=="Up")
}else if(functional_diffdata=="Down"){
diff_t<-diff_t %>% dplyr::filter(State=="Down")
}
if(nrow(diff_t) > 300){
diff_t %<>% arrange(p_val_adj)
diff_t <- diff_t[1:300,]
}
genename=as.character(unique(diff_t$gene))
data<-data.frame(gene=genename) %>%
left_join(transidenti,by=c("gene"="gene"))
data <- data[!is.na(data$KEGG.ID), ]
transannotationdata<-data %>%
left_join(diff_t,by=c("gene"="gene"))
# Run Annotation Count (New Function)
KEGG.ID_m<-data.frame(node=metabannotationdata$KEGG.ID,KEGG.ID=metabannotationdata$KEGG.ID)
KEGG.ID_t<-data.frame(node=transannotationdata$KEGG.ID,KEGG.ID=transannotationdata$KEGG.ID)
metabdatabse<-annotation_database[[1]]
transdatabse<-annotation_database[[2]]
result_m<-run_annotation_count(selectCid_data=KEGG.ID_m, database=metabdatabse,omics_type="metab")
result_t<-run_annotation_count(selectCid_data=KEGG.ID_t, database=transdatabse,omics_type="trans")
annotation_results<-list(result_m,result_t)
annotation_m<-annotation_results[[1]]
annotation_t<-annotation_results[[2]]
venn_list <- list(Metabolite = annotation_m$Pathway, Gene = annotation_t$Pathway)
# Sort by Count (New Logic)
annot_metab<-annotation_m %>% arrange(desc(Count))
annot_ko<-annotation_t %>% arrange(desc(Count))
annot_ko$Types<- "Gene"
annot_metab$Types<- "Metabolite"
all_annot<- rbind(annot_metab,annot_ko)
same_path<- intersect(annot_metab$Pathway,annot_ko$Pathway)
unique_metab <- setdiff(annot_metab$Pathway, annot_ko$Pathway)
unique_ko <- setdiff(annot_ko$Pathway, annot_metab$Pathway)
maplist<-list(same_path=same_path,unique_metab=unique_metab,unique_ko=unique_ko)
process_annot<-function(pathtype){
annot_metab<- annot_metab[which(annot_metab$Pathway %in% pathtype),]
annot_ko<- annot_ko[which(annot_ko$PathwayID %in% annot_metab$PathwayID),]
plotdata<- rbind(annot_metab,annot_ko)
plotdata <- plotdata[complete.cases(plotdata), ]
return(plotdata)
}
plotdata<- list(process_annot(same_path),process_annot(unique_metab),process_annot(unique_ko))
dotplot_data<-list(plotdata,all_annot,maplist)
return(list(venn_list=venn_list,dotplot_data=dotplot_data))
}
# Generate Plots using AnnotationDotPlot
dotplot_dataall=bub(diff_omics,metabidenti,transidenti,annotation_database,
functional_diffdata="all")
dotplot_data=dotplot_dataall$dotplot_data
venn_list=dotplot_dataall$venn_list
venn_list
vennplot_data=venn_list
p3 <- venn.diagram(vennplot_data,
col = "transparent",
fill = c('yellow', 'skyblue'),
alpha = 0.5, cex = 2,
fontfamily = "sans",
cat.cex = 2, cat.pos = 0,
cat.fontfamily = "sans",
rotation.degree = 0,
resolution = 300, filename = NULL)
CairoPDF("./4c1.pdf", width = 6, height = 6, family = "sans")
grid.draw(p3)
dev.off()
source("../../source/Pathway/annotation_stats.R")
source("./source/Pathway/annotation_stats.R")
# Source the new plotting script
source("./source/Pathway/AnnotationDotPlot.R")
setwd("E:/danbaidaixie/分析调研/空间多组学/流程/ai/en_20250811/validation_figure/benchmarks")
# Generate Plots using AnnotationDotPlot
dotplot_dataall=bub(diff_omics,metabidenti,transidenti,annotation_database,
functional_diffdata="all")
dotplot_data=dotplot_dataall$dotplot_data
venn_list=dotplot_dataall$venn_list
saveRDS(venn_list,"./rds/CA-vs-PAG/vennplot_datanew.RDS")
vennplot_data=readRDS("./rds/CA-vs-PAG/vennplot_datanew.RDS")
p3 <- venn.diagram(vennplot_data,
col = "transparent",
fill = c('yellow', 'skyblue'),
alpha = 0.5, cex = 2,
fontfamily = "sans",
cat.cex = 2, cat.pos = 0,
cat.fontfamily = "sans",
rotation.degree = 0,
resolution = 300, filename = NULL)
CairoPDF("./4c.pdf", width = 6, height = 6, family = "sans")
grid.draw(p3)
dev.off()
#4d---------------------------------------------------------------------------------------
#' @title Figure 4d: Pathway Enrichment Dot Plot
#' @description Visualizes top enriched pathways with bubble size representing count and color representing significance.
#' @return Generates a PDF '4d.pdf'.
df<-dotplot_data[[1]][[1]]
saveRDS(df,paste0("./rds/CA-vs-PAG/dotplot_save.RDS")) # Keeping filename for compatibility
pdf("./Figures/4d.pdf", width = 8, height = 6)
pdf("./4d.pdf", width = 8, height = 6)
print(AnnotationDotPlot(df))
dev.off()
